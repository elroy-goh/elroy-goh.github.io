<!-- Local override of al-folio's footer.liquid — no custom plugin tags. -->
<footer class="footer">
  <div class="container mt-0">
    &copy; Copyright {{ site.time | date: "%Y" }}
    {%- if site.first_name or site.last_name %}
      {{ site.first_name }} {{ site.last_name }}.
    {%- else %}
      {{ site.title }}.
    {%- endif %}

    {%- if site.social.github_username %}
      &ensp;·&ensp;
      <a href="https://github.com/{{ site.social.github_username }}"
         target="_blank" rel="noopener noreferrer">GitHub</a>
    {%- endif %}

    {%- if site.social.linkedin_username %}
      &ensp;·&ensp;
      <a href="https://www.linkedin.com/in/{{ site.social.linkedin_username }}/"
         target="_blank" rel="noopener noreferrer">LinkedIn</a>
    {%- endif %}

    {%- if site.email %}
      &ensp;·&ensp;
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    {%- endif %}
  </div>
</footer>
